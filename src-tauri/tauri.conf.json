{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Jdx TTS Studio",
  "version": "0.1.2",
  "identifier": "com.jdx.ttsstudio",
  "build": {
    "beforeDevCommand": "pnpm dev:web",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Jdx TTS Studio",
        "width": 1440,
        "height": 940,
        "minWidth": 1000,
        "minHeight": 680,
        "backgroundColor": "#17191c",
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*; media-src 'self' blob: http://127.0.0.1:*; object-src 'none'; frame-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "nsis"],
    "category": "Music",
    "shortDescription": "中文专业 AI 配音工作站",
    "longDescription": "基于百炼远程语音模型的专业配音、音频编辑和视频后期工作站。",
    "resources": {
      "resources/backend/": "backend/"
    },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "offlineInstaller", "silent": true },
      "nsis": {
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      }
    },
    "linux": {
      "appimage": { "bundleMediaFramework": true },
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0", "libsecret-1-0", "gstreamer1.0-plugins-good", "gstreamer1.0-libav"]
      }
    }
  }
}
